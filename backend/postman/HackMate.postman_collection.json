{
  "info": {
    "name": "HackMate",
    "description": "Every HackMate API endpoint. Run top to bottom against the seeded database (Collection Runner or newman). Login requests save tokens into collection variables; the run creates and then deletes its own hackathon and team.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "priyaToken",
      "value": ""
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "aryanId",
      "value": ""
